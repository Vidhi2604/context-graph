# Neo4j (local: bolt://localhost:7687 | cloud: neo4j+s://xxx.databases.neo4j.io)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password
NEO4J_POOL_SIZE=5

# Groq LLM (free tier — console.groq.com)
GROQ_API_KEY=gsk_xxxxxxxx

# Database (SQLite for local, Postgres for prod)
DATABASE_URL=file:./prisma/dev.db

# NextAuth
NEXTAUTH_SECRET=generate-32-random-chars-here
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (optional — console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Upstash Kafka (optional — console.upstash.com)
UPSTASH_KAFKA_REST_URL=
UPSTASH_KAFKA_REST_USERNAME=
UPSTASH_KAFKA_REST_PASSWORD=

# Upstash Redis for rate limiting (optional — console.upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Connector credentials (optional)
HUBSPOT_ACCESS_TOKEN=
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=
NURIX_API_URL=
NURIX_API_KEY=

# Demo mode — serve cached responses without LLM/Neo4j
DEMO_MODE=false

# Cron secret for event processor
CRON_SECRET=any-random-string
